{
  "app_settings": {
    "exchange": "binance",
    "default_market_type": "swap",
    "check_interval_minutes": 5,
    "log_level": "DEBUG",
    "max_workers": 2
  },
  "market_settings": {
    "timeframes": [
      "1h",
      "4h",
      "1d"
    ],
    "static_symbols": [
      "BTC",
      "ETH",
      "BNB"
    ],
    "dynamic_scan": {
      "enabled": false,
      "top_n_for_signals": 100,
      "primary_quote_currency": "USDT",
      "cross_market_filter": {
        "enabled": true,
        "must_exist_in": [
          "USDC"
        ]
      },
      "exclude_symbols": [
        "USDT",
        "USD1",
        "USDS",
        "USDC",
        "DAI",
        "TUSD",
        "BUSD",
        "FDUSD",
        "PAXG",
        "USDP",
        "GUSD",
        "USDD",
        "EUROC"
      ]
    },
    "api_limit": {
      "api_max_concurrency": 3,
      "api_min_interval_sec": 0.08,
      "api_max_retries": 3,
      "api_failure_threshold": 5,
      "api_circuit_breaker_cooldown_sec": 30,
      "api_429_base_backoff_sec": 2,
      "api_418_cooldown_sec": 60
    }
  },
  "strategy_params": {
    "trend_ema": {
      "long_period": 120
    },
    "dynamic_volume_multipliers": {
      "enabled": true,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "dynamic_atr_multipliers": {
      "enabled": false,
      "method": "linear_stepped",
      "min_multiplier": 1.5,
      "max_multiplier": 5.0,
      "apply_to_rank_n": 100,
      "rank_step_size": 3
    },
    "trend_ema_short": {
      "fast": 12,
      "medium": 26,
      "long": 60
    },
    "trend_ema_long": {
      "fast": 26,
      "medium": 50,
      "long": 120
    },
    "ma_breakout": {
      "enabled": true,
      "ma_type": "sma",
      "ma_periods": [
        7,
        25,
        99
      ],
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2.0,
      "exclude_timeframes": []
    },
    "ema_cross": {
      "enabled": true,
      "period": 120,
      "volume_confirm": true,
      "exempt_static_on_volume": true,
      "volume_multiplier": 2,
      "atr_period": 14,
      "atr_multiplier": 1.5,
      "exclude_timeframes": []
    },
    "kdj_cross": {
      "enabled": false,
      "fast_k": 9,
      "slow_k": 3,
      "slow_d": 3,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2,
      "exclude_timeframes": [
        "1d"
      ]
    },
    "volatility_breakout": {
      "enabled": false,
      "atr_period": 14,
      "atr_multiplier": 2.5,
      "volume_confirm": true,
      "exempt_static_on_volume": false,
      "volume_multiplier": 2.0,
      "exclude_timeframes": []
    },
    "level_breakout": {
      "enabled": true,
      "volume_confirm": true,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "level_detection": {
        "method": "advanced",
        "swing_pivots": {
          "enabled": true,
          "left_bars": 7,
          "right_bars": 7
        },
        "rolling_pivots": {
          "enabled": true
        }
      },
      "breakout_period": 120,
      "volume_ma_period": 20,
      "atr_period": 14,
      "atr_multiplier_breakout": 0.5,
      "exclude_timeframes": [],
      "overrides_by_timeframe": {
        "1d": {
          "level_detection": {
            "method": "advanced",
            "swing_pivots": {
              "enabled": true,
              "left_bars": 10,
              "right_bars": 10
            }
          }
        }
      }
    },
    "rsi_divergence": {
      "enabled": true,
      "rsi_period": 14,
      "lookback_period": 60,
      "exclude_timeframes": [
        "1h"
      ]
    },
    "ob_luxalgo": {
      "enabled": true,
      "swing_length": 5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": [
        "4h",
        "1d"
      ]
    },
    "ob_fluxcharts": {
      "enabled": true,
      "swing_length": 10,
      "atr_multiplier": 3.5,
      "alert_on_rejection": true,
      "alert_on_breakout": true,
      "exclude_timeframes": [
        "1h"
      ]
    },
    "trend_channel_breakout": [
      {
        "name": "短期趋势通道 (1h/4h)",
        "enabled": true,
        "min_trend_length": 10,
        "std_dev_multiplier": 1.5,
        "breakout_confirmation_atr": 0.1,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 1.5,
        "exclude_timeframes": [
          "1d"
        ],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 120
          },
          "4h": {
            "lookback_period": 80
          }
        }
      },
      {
        "name": "长期趋势通道 (All TFs)",
        "enabled": true,
        "min_trend_length": 20,
        "std_dev_multiplier": 1.8,
        "breakout_confirmation_atr": 0.2,
        "volume_confirm": false,
        "exempt_static_on_volume": true,
        "volume_multiplier": 2.0,
        "exclude_timeframes": [],
        "overrides_by_timeframe": {
          "1h": {
            "lookback_period": 300
          },
          "4h": {
            "lookback_period": 200
          },
          "1d": {
            "lookback_period": 150
          }
        }
      }
    ],
    "consecutive_candles": {
      "enabled": true,
      "dynamic_count": {
        "enabled": true,
        "method": "linear_stepped",
        "min_count": 6,
        "max_count": 12,
        "apply_to_rank_n": 100,
        "rank_step_size": 10,
        "default_count": 9
      },
      "min_consecutive_candles": 4,
      "volume_confirm": false,
      "exempt_static_on_volume": true,
      "volume_multiplier": 1.5,
      "exclude_timeframes": [
        "15m"
      ]
    }
  }
}
