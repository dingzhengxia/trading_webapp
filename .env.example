# 复制为项目根目录下的 .env（与 deploy.sh / start.bat 同级）后填入真实值
# 该文件已被 .gitignore / .dockerignore 忽略：不会进入 Git，也不会进入镜像
# 改完需重启后端进程；Docker 部署需重建容器（--env-file 只在创建时读取）
# 交易所 API（合约交易权限，建议只开合约、禁用提现）
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 钉钉机器人（可选）：不配置则不推送，只在网页日志显示
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# Docker 部署时由镜像设置，本地运行不要填
# IS_DOCKER=1
