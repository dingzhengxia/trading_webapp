# .dockerignore

# Git
.git
.gitignore

# 环境变量（含交易所密钥 / 钉钉 webhook）：放在项目根目录，不入镜像
.env
.env.*
!.env.example

# 本地运行态数据
data/
*.db
*.db-wal
*.db-shm

# Docker
Dockerfile
.dockerignore

# IDE/Editor folders
.vscode/
.idea/

# Python virtual environment
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc

# Node.js dependencies
frontend/node_modules/

# Frontend build artifacts (we build them inside the container)
frontend/dist/

# OS-specific files
.DS_Store
Thumbs.db